{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgun-final-uat",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-15",
  "d1_databases": [{ "binding": "DB", "database_name": "chatgun-final-uat", "database_id": "e3cb426c-b88a-4b93-90fd-39df524f68ae", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "chatgun-final-uat-media" }],
  "vars": {
    "OAUTH_LOGIN_ENABLED": "true",
    "OAUTH_ENABLED_PROVIDERS": "SET_FROM_APPROVED_A_B_ONLY",
    "NEW_ACCOUNT_REGISTRATION_ENABLED": "false",
    "BETA_INVITATION_REGISTRATION_ENABLED": "true",
    "BETA_ENROLLMENT_REQUIRED": "true",
    "ACCEPTANCE_FLOW_ENABLED": "true",
    "ADULT_ONBOARDING_ENABLED": "true",
    "SOCIAL_APP_ENABLED": "true",
    "ADULT_NOTICE_VERSION": "adult-social-always-on-uat-2026-10-28-rc4",
    "TERMS_VERSION": "terms-social-always-on-uat-2026-10-28-rc4",
    "PRIVACY_VERSION": "privacy-social-always-on-uat-2026-10-28-rc4",
    "UAT_PRIVATE_COHORT_REQUIRED": "true",
    "UAT_ACCESS_MODE": "always-on-until-explicit-close",
    "PUBLIC_DISCOVERY_ENABLED": "true",
    "MESSAGING_ENABLED": "true",
    "PRESENCE_ENABLED": "true",
    "RATINGS_ENABLED": "false",
    "MEDIA_UPLOAD_ENABLED": "false",
    "MEDIA_QUARANTINE_ENABLED": "true",
    "MODERATION_TOOLS_ENABLED": "false",
    "ACCOUNT_MODERATION_ENABLED": "false",
    "ELIGIBILITY_REVIEW_ENABLED": "true",
    "IDENTITY_VERIFICATION_ENABLED": "false",
    "SENSITIVE_CONTENT_ENABLED": "false",
    "EMAIL_OTP_ENABLED": "false",
    "MOBILE_OTP_ENABLED": "false",
    "LINE_EMAIL_ENABLED": "false",
    "FACEBOOK_EMAIL_ENABLED": "false",
    "FRIEND_REQUESTS_ENABLED": "false",
    "DEMO_MODE_ENABLED": "false",
    "DEMO_AUTO_START_ENABLED": "false",
    "PUBLIC_DEMO_CANARY_ENABLED": "false",
    "ADMIN_ACCESS_STANDALONE_ENABLED": "false",
    "ADMIN_CLOUDFLARE_ACCESS_REQUIRED": "true",
    "UAT_AUDIT_RETENTION_DAYS": "90",
    "UAT_AUDIT_RETENTION_START_MODE": "actual-campaign-close"
  }
}
