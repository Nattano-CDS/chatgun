# Local-only example. Copy to .dev.vars; never commit real values.
OTP_PEPPER=replace-with-at-least-32-random-bytes
RATE_LIMIT_PEPPER=replace-with-a-different-32-byte-value
RESEND_API_KEY=re_local_only
EMAIL_FROM=ChatGun <login@example.com>
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
FACEBOOK_CLIENT_ID=replace-me
FACEBOOK_CLIENT_SECRET=replace-me
FACEBOOK_GRAPH_VERSION=replace-with-current-vN.0
LINE_CLIENT_ID=replace-me
LINE_CLIENT_SECRET=replace-me
LINE_EMAIL_ENABLED=false
NEW_ACCOUNT_REGISTRATION_ENABLED=false
BETA_INVITATION_REGISTRATION_ENABLED=false
ACCEPTANCE_FLOW_ENABLED=false
SOCIAL_APP_ENABLED=false
ADULT_ONBOARDING_ENABLED=false
PUBLIC_DISCOVERY_ENABLED=false
FRIEND_REQUESTS_ENABLED=false
MESSAGING_ENABLED=false
MEDIA_UPLOAD_ENABLED=false
MEDIA_QUARANTINE_ENABLED=true
RATINGS_ENABLED=false
IDENTITY_VERIFICATION_ENABLED=false
MODERATION_TOOLS_ENABLED=false
DEMO_MODE_ENABLED=false
# Required only when acceptance/onboarding is explicitly enabled in isolated staging.
ADULT_NOTICE_VERSION=owner-legal-review-required
TERMS_VERSION=owner-legal-review-required
PRIVACY_VERSION=owner-legal-review-required
