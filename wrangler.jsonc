{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgun",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-15",
  "vars": {
    "PRESENCE_ENABLED": "false",
    "EMAIL_OTP_ENABLED": "false",
    "MOBILE_OTP_ENABLED": "false",
    "LINE_EMAIL_ENABLED": "false",
    "NEW_ACCOUNT_REGISTRATION_ENABLED": "false",
    "BETA_INVITATION_REGISTRATION_ENABLED": "false",
    "ACCEPTANCE_FLOW_ENABLED": "true",
    "SOCIAL_APP_ENABLED": "true",
    "ADULT_ONBOARDING_ENABLED": "true",
    "ADULT_NOTICE_VERSION": "controlled-beta-v1",
    "TERMS_VERSION": "controlled-beta-terms-v1",
    "PRIVACY_VERSION": "controlled-beta-privacy-v1",
    "PUBLIC_DISCOVERY_ENABLED": "true",
    "FRIEND_REQUESTS_ENABLED": "false",
    "MESSAGING_ENABLED": "true",
    "MEDIA_UPLOAD_ENABLED": "true",
    "MEDIA_QUARANTINE_ENABLED": "true",
    "SENSITIVE_CONTENT_ENABLED": "false",
    "RATINGS_ENABLED": "true",
    "IDENTITY_VERIFICATION_ENABLED": "false",
    "MODERATION_TOOLS_ENABLED": "true",
    "DEMO_MODE_ENABLED": "false",
    "DEMO_AUTO_START_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatgun-auth-staging",
      "database_id": "5bbfd55d-eb22-4324-8a7d-57bef14110ea",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chatgun-media-staging"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
        "OAUTH_ENABLED_PROVIDERS": "line",
        "FACEBOOK_EMAIL_ENABLED": "false",
        "PRESENCE_ENABLED": "false",
        "EMAIL_OTP_ENABLED": "false",
        "MOBILE_OTP_ENABLED": "false",
        "LINE_EMAIL_ENABLED": "false",
        "NEW_ACCOUNT_REGISTRATION_ENABLED": "false",
        "BETA_INVITATION_REGISTRATION_ENABLED": "true",
        "ACCEPTANCE_FLOW_ENABLED": "true",
        "SOCIAL_APP_ENABLED": "true",
        "ADULT_ONBOARDING_ENABLED": "true",
        "ADULT_NOTICE_VERSION": "adult-beta-2026-10-20-rc1",
        "TERMS_VERSION": "terms-beta-2026-10-20-rc1",
        "PRIVACY_VERSION": "privacy-beta-2026-10-20-rc1",
        "PUBLIC_DISCOVERY_ENABLED": "false",
        "FRIEND_REQUESTS_ENABLED": "false",
        "MESSAGING_ENABLED": "false",
        "MEDIA_UPLOAD_ENABLED": "false",
        "MEDIA_QUARANTINE_ENABLED": "true",
        "SENSITIVE_CONTENT_ENABLED": "false",
        "RATINGS_ENABLED": "false",
        "IDENTITY_VERIFICATION_ENABLED": "false",
        "MODERATION_TOOLS_ENABLED": "true",
        "ACCOUNT_MODERATION_ENABLED": "false",
        "ELIGIBILITY_REVIEW_ENABLED": "false",
        "ADMIN_ACCESS_STANDALONE_ENABLED": "false",
        "ADMIN_CLOUDFLARE_ACCESS_REQUIRED": "true",
        "DEMO_MODE_ENABLED": "false",
        "DEMO_AUTO_START_ENABLED": "false",
        "PUBLIC_DEMO_CANARY_ENABLED": "false",
        "OAUTH_LOGIN_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatgun-auth",
          "database_id": "9738a051-d914-42d0-8e7b-8098ef2b959d",
          "migrations_dir": "migrations/production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "chatgun-media-production"
        }
      ]
    }
  }
}
