{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgun",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-10-15",
  "vars": {
    "EMAIL_OTP_ENABLED": "false",
    "MOBILE_OTP_ENABLED": "false",
    "LINE_EMAIL_ENABLED": "false",
    "NEW_ACCOUNT_REGISTRATION_ENABLED": "true",
    "BETA_INVITATION_REGISTRATION_ENABLED": "false",
    "ACCEPTANCE_FLOW_ENABLED": "true",
    "SOCIAL_APP_ENABLED": "true",
    "ADULT_ONBOARDING_ENABLED": "true",
    "ADULT_NOTICE_VERSION": "controlled-beta-v1",
    "TERMS_VERSION": "controlled-beta-terms-v1",
    "PRIVACY_VERSION": "controlled-beta-privacy-v1",
    "PUBLIC_DISCOVERY_ENABLED": "true",
    "FRIEND_REQUESTS_ENABLED": "true",
    "MESSAGING_ENABLED": "true",
    "MEDIA_UPLOAD_ENABLED": "true",
    "MEDIA_QUARANTINE_ENABLED": "false",
    "RATINGS_ENABLED": "true",
    "IDENTITY_VERIFICATION_ENABLED": "false",
    "MODERATION_TOOLS_ENABLED": "false",
    "DEMO_MODE_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatgun-auth-staging",
      "database_id": "5bbfd55d-eb22-4324-8a7d-57bef14110ea",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "chatgun-media-staging"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "EMAIL_OTP_ENABLED": "false",
        "MOBILE_OTP_ENABLED": "false",
        "LINE_EMAIL_ENABLED": "false",
        "NEW_ACCOUNT_REGISTRATION_ENABLED": "false",
        "BETA_INVITATION_REGISTRATION_ENABLED": "false",
        "ACCEPTANCE_FLOW_ENABLED": "false",
        "SOCIAL_APP_ENABLED": "false",
        "ADULT_ONBOARDING_ENABLED": "false",
        "ADULT_NOTICE_VERSION": "controlled-beta-v1",
        "TERMS_VERSION": "pending-owner-approval",
        "PRIVACY_VERSION": "pending-owner-approval",
        "PUBLIC_DISCOVERY_ENABLED": "false",
        "FRIEND_REQUESTS_ENABLED": "false",
        "MESSAGING_ENABLED": "false",
        "MEDIA_UPLOAD_ENABLED": "false",
        "MEDIA_QUARANTINE_ENABLED": "true",
        "RATINGS_ENABLED": "false",
        "IDENTITY_VERIFICATION_ENABLED": "false",
        "MODERATION_TOOLS_ENABLED": "false",
        "DEMO_MODE_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chatgun-auth",
          "database_id": "9738a051-d914-42d0-8e7b-8098ef2b959d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": []
    }
  }
}
