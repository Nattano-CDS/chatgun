/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; img-src 'self' data: https:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

/signup.html
  Cache-Control: no-store

/signup
  Cache-Control: no-store

/account.html
  Cache-Control: no-store

/account
  Cache-Control: no-store

/acceptance*
  Cache-Control: no-store

/
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/app/*
  Cache-Control: no-store

/release.json
  Cache-Control: no-store

/release-assets.json
  Cache-Control: no-store

/privacy*
  Cache-Control: no-cache, no-transform

/terms*
  Cache-Control: no-cache, no-transform

/data-deletion*
  Cache-Control: no-cache, no-transform

/beta-notice*
  Cache-Control: no-cache, no-transform

/canary-notice.html
  Cache-Control: no-cache, no-transform
